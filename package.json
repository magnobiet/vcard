{
  "name": "nextjs-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "test": "NODE_ENV=test jest --reporters default",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:setup": "playwright install chromium firefox",
    "lint": "eslint src/ ",
    "lint:fix": "pnpm lint --fix",
    "lint:staged": "lint-staged --config lint-staged.config.mjs",
    "lint:commit": "commitlint --config commitlint.config.ts",
    "lint:dependencies": "knip --config knip.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "cleanup": "rm -rf out dist .next .swc coverage test-results",
    "reset": "pnpm cleanup && rm -rf node_modules pnpm-lock.yaml && pnpm install --offline",
    "favicon:build": "node --no-warnings --experimental-strip-types ./favicon/generate.ts",
    "postfavicon:build": "rm -rf ./public/site.webmanifest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "prepare": "is-ci >/dev/null 2>&1 || husky"
  },
  "dependencies": {
    "@base-ui/react": "~1.7.0",
    "@configcat/sdk": "~1.1.0",
    "@icons-pack/react-simple-icons": "~13.15.1",
    "@next/third-parties": "~16.3.2",
    "@sentry/nextjs": "~10.75.2",
    "@t3-oss/env-nextjs": "~0.13.11",
    "@upstash/ratelimit": "~2.0.8",
    "@upstash/redis": "~1.38.2",
    "@vercel/analytics": "~2.0.1",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "lucide-react": "~1.34.0",
    "next": "~16.3.1",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-hook-form": "~7.86.0",
    "resend": "~6.20.0",
    "shadcn": "~4.18.0",
    "sonner": "~2.0.8",
    "tailwind-merge": "~3.6.0",
    "tw-animate-css": "~1.4.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@realfavicongenerator/generate-favicon": "^0.8.4",
    "@realfavicongenerator/image-adapter-node": "^0.8.4",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/nextjs": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/jest": "^30.0.0",
    "@types/k6": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
